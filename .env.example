# Filled in by `neon link` / `neon env pull` (see README).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Not provided by Neon. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Live collaboration (optional). Written by `neon env pull --service postgres --service realtime`
# once Realtime is enabled. Without them, shared plans still work but update on Save.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
